### ~/.config/sway/config
### Ported from Hyprland config — same terminal/menu/apps, monitor layout,
### workspace assignments, and keybinds. Nvidia notes are inline (search "NVIDIA").

################################
### NVIDIA — READ THIS FIRST ###
################################
# Sway on Nvidia needs these three things or you'll get flicker, crashes, or
# no output at all:
#
# 1. Kernel modeset (put this in your kernel cmdline / mkinitcpio, not here):
#      nvidia-drm.modeset=1
#    Check it's active:  cat /sys/module/nvidia_drm/parameters/modeset  -> Y
#
# 2. Env vars below (GBM backend + hardware cursor workaround). These must be
#    set BEFORE sway starts — put them in ~/.config/environment.d/nvidia.conf
#    (systemd user env) or export them from the script that launches sway,
#    NOT just in this file, since some are read very early. Setting them here
#    too doesn't hurt and covers child processes.
#
# 3. Use a recent proprietary driver (555+) — open-source "nouveau" struggles
#    badly with wlroots compositors, and older proprietary drivers lack the
#    explicit-sync support Sway 1.9+ wants. If you're on nouveau, expect pain.

set $nvidia_gbm GBM_BACKEND=nvidia-drm
set $nvidia_glx __GLX_VENDOR_LIBRARY_NAME=nvidia
set $nvidia_cursor WLR_NO_HARDWARE_CURSORS=1
# If you still get a black screen on launch, also try adding:
#   WLR_DRM_NO_ATOMIC=1
# to environment.d/nvidia.conf (older driver atomic-modeset bug).

exec_always systemctl --user import-environment GBM_BACKEND __GLX_VENDOR_LIBRARY_NAME WLR_NO_HARDWARE_CURSORS

###################
### MY PROGRAMS ###
###################

set $terminal kitty
set $fileManager dolphin
set $menu wofi --show drun

#################
### AUTOSTART ###
#################

exec_always waybar
exec swaync
exec_always swaybg -o DP-3 -i ~/dotfiles/hyprpaper/wallpaper.jpg -m fill
# ^ swww's daemon (swww-daemon) does work fine under Sway too if you'd rather
#   keep using it — just replace the swaybg line with:
#     exec_always swww-daemon
#     exec_always sleep 1 && ~/dotfiles/hyprpaper/.config/hypr/switchwallpaper.sh
exec nm-applet --indicator
exec sleep 12 && ~/dotfiles/scripts/splitwindows065.sh
# exec wl-paste --type text --watch cliphist store
# exec wl-paste --type image --watch cliphist store

#############################
### ENVIRONMENT VARIABLES ###
#############################

set $XCURSOR_SIZE 24
seat seat0 xcursor_theme breeze_cursors 24

exec_always export XDG_MENU_PREFIX=arch-
exec_always export XCURSOR_SIZE=24
exec_always export XCURSOR_THEME=breeze_cursors
exec_always export QT_QPA_PLATFORMTHEME=qt6ct
exec_always export HYPRSHOT_DIR=$HOME/Pictures/Screenshot

exec gsettings set org.gnome.desktop.interface gtk-theme "Breeze_Dark"
exec gsettings set org.gnome.desktop.interface color-scheme "prefer-dark"

################
### MONITORS ###
################
# Sway has no "auto-left" shorthand — positions are explicit pixel offsets.
# DP-3 is primary at 0,0; DP-4 sits to its left, so it's offset negative by
# its own width (2560).

output DP-3 resolution 2560x1440@144Hz position 0,0
output DP-4 resolution 2560x1440@144Hz position -2560,0

#####################
### LOOK AND FEEL ###
#####################
# Sway can't do gradient borders or blur/shadow like Hyprland (no compositor
# effects layer) — closest solid-color equivalents below. If you want blur,
# you'd need to layer a separate compositor, which usually isn't worth it
# on Nvidia + Sway.

gaps inner 0
gaps outer 0
default_border pixel 0
default_floating_border pixel 1
smart_borders off

client.focused          #33ccff #33ccff #ffffff #33ccff #33ccff
client.focused_inactive #595959 #595959 #ffffff #595959 #595959
client.unfocused        #595959 #595959 #aaaaaa #595959 #595959

# Sway's animation system is minimal (just window open/close speed via
# some forks) — vanilla Sway has none. If you want animations like Hyprland's,
# you'd need sway-animations patches or switch compositors; leaving this
# noted rather than faking it.

#############
### INPUT ###
#############

input "type:keyboard" {
    xkb_layout no
    xkb_variant ""
}

input "type:touchpad" {
    natural_scroll disabled
}

# Per-device overrides (match by identifier, run `swaymsg -t get_inputs` to
# find exact names — Sway's matching is stricter than Hyprland's).
input "type:pointer" {
    pointer_accel -0.5
}

###################
### KEYBINDINGS ###
###################

set $mainMod Mod4

bindsym $mainMod+q exec $terminal
bindsym $mainMod+c kill
bindsym $mainMod+m exit
bindsym $mainMod+e exec $fileManager
bindsym $mainMod+y exec $terminal yazi
bindsym $mainMod+j floating toggle
bindsym $mainMod+Shift+r reload
bindsym $mainMod+p layout toggle split

bindsym Mod4+f exec firefox
bindsym Mod4+t exec $terminal
bindsym Mod4+space exec $menu
bindsym Mod4+v exec code
bindsym Mod4+o exec waypaper
bindsym Mod4+l exec swaylock
bindsym Mod4+z fullscreen
bindsym Mod4+Shift+s exec grim -g "$(slurp)" ~/Pictures/Screenshot/$(date +%Y-%m-%d_%H-%m-%s).png
# ^ Sway has no hyprshot equivalent built in; grim+slurp is the standard
#   region-screenshot combo. hyprshot itself is Hyprland-only.

# Move focus with mainMod + arrow keys
bindsym $mainMod+Left focus left
bindsym $mainMod+Right focus right
bindsym $mainMod+Up focus up
bindsym $mainMod+Down focus down

# Switch workspaces with mainMod + [0-9]
bindsym $mainMod+1 workspace 1
bindsym $mainMod+2 workspace 2
bindsym $mainMod+3 workspace 3
bindsym $mainMod+4 workspace 4
bindsym $mainMod+5 workspace 5
bindsym $mainMod+6 workspace 6
bindsym $mainMod+7 workspace 7
bindsym $mainMod+8 workspace 8
bindsym $mainMod+9 workspace 9
bindsym $mainMod+0 workspace 10

# Move active window to a workspace with mainMod + SHIFT + [0-9]
bindsym $mainMod+Shift+1 move container to workspace 1
bindsym $mainMod+Shift+2 move container to workspace 2
bindsym $mainMod+Shift+3 move container to workspace 3
bindsym $mainMod+Shift+4 move container to workspace 4
bindsym $mainMod+Shift+5 move container to workspace 5
bindsym $mainMod+Shift+6 move container to workspace 6
bindsym $mainMod+Shift+7 move container to workspace 7
bindsym $mainMod+Shift+8 move container to workspace 8
bindsym $mainMod+Shift+9 move container to workspace 9
bindsym $mainMod+Shift+0 move container to workspace 10

# Scroll through existing workspaces with mainMod + scroll
bindsym $mainMod+button4 workspace next
bindsym $mainMod+button5 workspace prev

# Move/resize windows with mainMod + LMB/RMB and dragging
floating_modifier $mainMod normal
bindsym $mainMod+button1 move
bindsym $mainMod+button3 resize

# Laptop multimedia keys for volume and LCD brightness
bindsym --locked XF86AudioRaiseVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+
bindsym --locked XF86AudioLowerVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bindsym --locked XF86AudioMute exec wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
bindsym --locked XF86AudioMicMute exec wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle
bindsym --locked XF86MonBrightnessUp exec brightnessctl s 10%+
bindsym --locked XF86MonBrightnessDown exec brightnessctl s 10%-

bindsym --locked XF86AudioNext exec playerctl next
bindsym --locked XF86AudioPause exec playerctl play-pause
bindsym --locked XF86AudioPlay exec playerctl play-pause
bindsym --locked XF86AudioPrev exec playerctl previous

##############################
### WINDOWS AND WORKSPACES ###
##############################

workspace 1 output DP-3
workspace 2 output DP-3
workspace 3 output DP-3
workspace 9 output DP-4
workspace 10 output DP-4

exec sleep 7 && swaymsg workspace 1
exec swaymsg workspace 3
exec swaymsg workspace 10

# on-created-empty has no direct Sway equivalent — Sway assigns apps to
# workspaces via for_window app_id/class matches (below), and you launch
# the app once yourself rather than the compositor spawning it for you.

### Window / App Rules ###
# Note: XWayland apps (Steam, Battle.net, most non-native games/launchers)
# match on `class`; native Wayland apps match on `app_id`. Run
# `swaymsg -t get_tree` while the app is open if a rule doesn't fire, to
# check which one it's actually reporting.

for_window [class="steam"] move to workspace 3
for_window [class="steam"] floating disable
for_window [class="net.lutris.Lutris"] move to workspace 3
for_window [app_id="org.prismlauncher.PrismLauncher"] move to workspace 3
for_window [title="Battle.net"] move to workspace 3
for_window [app_id="discord"] move to workspace 10
for_window [title="Friends List"] move to workspace 10

for_window [app_id="waypaper"] floating enable
for_window [app_id="org.pulseaudio.pavucontrol"] floating enable, resize set 1000 800
for_window [app_id="qalculate-gtk"] floating enable, resize set 800 600

# Sway doesn't have a global "suppress maximize events" or the XWayland
# no_focus drag-fix rule Hyprland has — those are Hyprland-specific
# workarounds for issues Sway's wlroots handling doesn't hit the same way.

for_window [shell="xwayland"] title_format "%title [XWayland]"
